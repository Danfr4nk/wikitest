#!/usr/bin/env python3
"""Regenerate raw/facebook-threads/MANIFEST.json from the thread files.

The manifest is tracked and the thread bodies are not, so it is the only public
statement of what the Facebook archive contains: counts, date ranges,
counterparty names, no message text. That makes it a measurement, and dat:0052
records the rule such a thing has to obey — generated, never hand-edited,
because a number somebody could quietly adjust is not a measurement.

It has already been edited by hand once, and that is why this exists. The
manifest written on 2026-09-08 reported 15,812 messages across 385 threads. Run
against the same files by the parser `bin/wb-corroborate` actually searches
with, 34 of them come out lower — 254 messages that the earlier count included
and the search cannot see. Two counts of one archive, from two versions of one
regex, and the archive was never the thing that changed.

So this imports the parser rather than restating it. Whatever
`bin/wb-corroborate` can find is what the manifest reports, by construction. If
the parser is wrong they are wrong together, which is recoverable; if they
disagree the manifest describes an archive nobody is searching, which is not.
"""

import collections
import hashlib
import importlib.machinery
import importlib.util
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
THREADS = ROOT / "raw" / "facebook-threads"


def parser():
    """The block regex from wb-corroborate, imported rather than copied."""
    spec = importlib.util.spec_from_loader(
        "wb_corroborate",
        importlib.machinery.SourceFileLoader("wb_corroborate",
                                             str(ROOT / "bin" / "wb-corroborate")))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def main() -> int:
    mod = parser()
    block = mod.BLOCK
    # Every message in the export sits under a rule of underscores, whatever
    # else about it the block pattern can or cannot read. Counting both is what
    # turns an unexplained discrepancy into a stated denominator: the gap is the
    # part of the archive wb-corroborate cannot date or attribute, and therefore
    # cannot search. The 2026-09-08 manifest reported the separator count as the
    # message count, which is why it read 254 higher than the searchable one.
    rule = re.compile(r"^_{6,}$", re.M)

    index, total, present, unparsed, seen = [], 0, 0, [], {}
    for path in sorted(THREADS.glob("*.txt")):
        raw = path.read_bytes()
        digest = hashlib.sha256(raw).hexdigest()
        if digest in seen:
            unparsed.append(f"{path.name}: byte-identical to {seen[digest]}")
            continue
        seen[digest] = path.name

        text = raw.decode("utf-8", "replace").replace("\r", "")
        hits = block.findall(text)
        if not hits:
            unparsed.append(f"{path.name}: no parseable message blocks")
            continue
        blocks = len(rule.findall(text))
        names = collections.Counter(who.strip() for who, *_ in hits)
        years = sorted({year for *_, year in hits})
        index.append({
            "file": path.name,
            "bytes": len(raw),
            "messages": len(hits),
            "message_blocks": blocks,
            "from_dan": sum(1 for who, *_ in hits if who.strip() == "Dan Frank"),
            "counterparties": sorted(n for n in names if n != "Dan Frank"),
            "years": [years[0], years[-1]] if years else [],
        })
        total += len(hits)
        present += blocks

    manifest = json.loads((THREADS / "MANIFEST.json").read_text())
    manifest["note"] = ("Thread-level metadata only. Contents gitignored — same reasoning as "
                        "corpus/messages.csv. Generated by bin/wb-facebook-manifest; do not "
                        "hand-edit, rerun the tool (dat:0052).")
    manifest["threads"] = len(index)
    rows, _ = mod.load_facebook()
    load = mod.load_facebook
    archive = len(rows) + load.no_text + load.unattributed + load.empty
    manifest["total_messages"] = len(rows)
    manifest["archive_messages"] = archive
    manifest["not_searchable"] = {
        "no_text": load.no_text,
        "unattributed_in_group_thread": load.unattributed,
        "empty_segment": load.empty,
    }
    manifest["denominator"] = (
        f"{archive} messages carry a timestamp, which is the archive's true count. "
        f"{len(rows)} of them carry attributable text and are searchable by "
        f"bin/wb-corroborate. Of the rest, {load.no_text} have a timestamp and no "
        f"text (attachments, stickers, call notices), {load.unattributed} sit "
        f"unheaded in threads naming more than two participants and are counted "
        f"rather than guessed, and {load.empty} are empty segments. A null result "
        f"from a search is a null over the searchable {len(rows)}, not over the "
        f"archive. The per-thread `messages` figures below are name-headed blocks "
        f"only and undercount any thread whose counterparty the export left "
        f"unnamed — see dat:0054.")
    manifest["files_on_disk"] = len(list(THREADS.glob("*.txt")))
    manifest["skipped"] = unparsed
    manifest["thread_index"] = index
    (THREADS / "MANIFEST.json").write_text(json.dumps(manifest, indent=1) + "\n")

    print(f"{len(index)} threads, {len(rows)} of {archive} messages searchable "
          f"({load.no_text} no text, {load.unattributed} unattributed, "
          f"{load.empty} empty), {len(unparsed)} files skipped")
    for line in unparsed:
        print(f"  skip  {line}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
