#!/usr/bin/env python3
"""Search the raw corpus for evidence bearing on a claim.

Extraction from the prior wiki produces claims of the form *"the old wiki
asserted P."* True, checkable, and not yet evidence that P. This is what turns
one into the other: it goes and looks.

Three outcomes, and the third is the one that needs care.

  CORROBORATED   an independent dated record says the same thing
  CONTRADICTED   an independent dated record says otherwise
  NOT FOUND      which is `never_observed` and NOT `known_not_to_occur`

The corpus has holes — whole months with no messages — so absence proves
nothing unless the window is covered. Every search therefore reports coverage
for the window it searched, and refuses to let a null result pass as a negative
finding. That distinction has already changed one conclusion in this repository
(see kb/data/0028) and it is the whole reason this tool prints coverage at all.

Usage:
  bin/wb-corroborate "exact phrase"
  bin/wb-corroborate --any doctor prescription pharmacy
  bin/wb-corroborate "combos" --from 2015 --to 2016
  bin/wb-corroborate "lemons" --context 2        # surrounding messages
  bin/wb-corroborate --coverage 2025-06          # just: is this window covered?

The corpus is gitignored and re-pullable; --pull fetches it and verifies the
sha256 against corpus/manifest.json before use.

Standard library only.
"""

from __future__ import annotations

import argparse
import collections
import csv
import hashlib
import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CORPUS = ROOT / "corpus" / "messages.csv"
MANIFEST = ROOT / "corpus" / "manifest.json"

csv.field_size_limit(10 ** 9)


def ensure_corpus(pull: bool) -> dict:
    manifest = json.loads(MANIFEST.read_text())
    if not CORPUS.exists():
        if not pull:
            raise SystemExit(
                f"{CORPUS.relative_to(ROOT)} is not present (it is gitignored).\n"
                f"Re-pull it with:  bin/wb-corroborate --pull ...")
        url = ("https://docs.google.com/spreadsheets/d/"
               f"{manifest['source']['sheet_id']}/export?format=csv")
        print(f"  pulling corpus from the backing sheet…", file=sys.stderr)
        CORPUS.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["curl", "-sS", "-L", "--max-time", "300", "-o", str(CORPUS), url],
                       check=True)
    size = CORPUS.stat().st_size
    digest = hashlib.sha256(CORPUS.read_bytes()).hexdigest()
    if size != manifest["bytes"] or digest != manifest["sha256"]:
        raise SystemExit(
            f"corpus does not match the manifest — refusing to search it.\n"
            f"  bytes  {size:,} vs {manifest['bytes']:,}\n"
            f"  sha256 {digest[:16]}… vs {manifest['sha256'][:16]}…")
    return manifest


def normalise(text: str) -> str:
    return text.replace("’", "'").replace("“", '"').replace("”", '"').lower()


def load(rows_wanted: tuple[str, str] | None):
    """Yield (date, is_from_me, sender, text) — and tally coverage by month."""
    coverage: collections.Counter = collections.Counter()
    rows = []
    with CORPUS.open(newline="", encoding="utf-8", errors="replace") as fh:
        for row in csv.DictReader(fh):
            date = (row.get("date_sent") or "")[:10]
            coverage[date[:7]] += 1
            if rows_wanted and not (rows_wanted[0] <= date[:len(rows_wanted[0])] or True):
                pass
            rows.append((date,
                         str(row.get("is_from_me", "")).strip() in ("1", "True", "true"),
                         (row.get("sender") or "").strip(),
                         row.get("text") or ""))
    return rows, coverage


def coverage_report(month: str, coverage: collections.Counter) -> str:
    """Graded, not binary.

    A month holding 35 messages in a corpus whose median month holds a thousand
    is a hole wearing a number. The first version of this tool called that
    COVERED, which is precisely the reading that produced the wrong conclusion
    in kb/data/0028 — so the threshold is relative to the corpus's own shape
    rather than to zero.
    """
    n = coverage.get(month, 0)
    live = sorted(v for v in coverage.values() if v)
    median = live[len(live) // 2] if live else 0
    share = n / median if median else 0
    if n == 0:
        verdict = ("EMPTY — absence here is `never_observed`, not `known_not_to_occur`. "
                   "A null result proves nothing.")
    elif share < 0.15:
        verdict = (f"THIN — {n} messages against a median month of {median}. "
                   f"Treat a null result here as `never_observed`; the window is "
                   f"nominally present and evidentially close to absent.")
    elif share < 0.5:
        verdict = (f"PARTIAL — {n} against a median of {median}. A null result is weak "
                   f"evidence of absence, not none.")
    else:
        verdict = (f"COVERED — {n} against a median of {median}. A null result here is "
                   f"informative.")
    return f"{month}: {n:,} messages\n  {verdict}"


MONTHS = {m: i for i, m in enumerate(
    "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split(), 1)}


def load_facebook():
    """Parse the export's block structure — NAME / rule / text / timestamp.

    Parsing the BLOCK rather than the line is not a style preference. Nothing in
    a message's text carries its speaker, so a first-person sentence lifted out
    of its block reads identically whoever typed it. That is exactly how the
    prior wiki recorded another person's DUI as an unexplained fact about the
    subject (kb/data/0031). Every hit this returns carries its speaker.
    """
    import collections
    root = pathlib.Path(ROOT / "raw" / "facebook-threads")
    block = re.compile(
        r"^([A-Z][A-Za-z.'\- ]{2,40})\n_{6,}\n+(.*?)\n+"
        r"((?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) (\d+), (\d{4})[^\n]*)",
        re.M | re.S)
    rows, coverage = [], collections.Counter()
    for path in sorted(root.glob("*.txt")):
        text = path.read_text(encoding="utf-8", errors="replace").replace("\r", "")
        for who, msg, stamp, day, year in block.findall(text):
            month = MONTHS.get(stamp[:3], 0)
            date = f"{year}-{month:02d}-{int(day):02d}" if month else year
            coverage[date[:7]] += 1
            rows.append((date, who.strip() == "Dan Frank", who.strip(), msg.strip()))
    rows.sort(key=lambda r: r[0])
    return rows, coverage


def window_months(lo: str, hi: str) -> list[str]:
    out = []
    y, m = int(lo[:4]), int(lo[5:7]) if len(lo) >= 7 else 1
    ey, em = int(hi[:4]), int(hi[5:7]) if len(hi) >= 7 else 12
    while (y, m) <= (ey, em):
        out.append(f"{y:04d}-{m:02d}")
        m += 1
        if m > 12:
            m, y = 1, y + 1
    return out


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("terms", nargs="*", help="phrase to find, or several terms with --any")
    ap.add_argument("--any", action="store_true", help="match any term rather than the phrase")
    ap.add_argument("--from", dest="lo", default="", help="earliest date, YYYY or YYYY-MM")
    ap.add_argument("--to", dest="hi", default="", help="latest date, YYYY or YYYY-MM")
    ap.add_argument("--mine", action="store_true", help="outbound messages only")
    ap.add_argument("--context", type=int, default=0, help="messages either side of a hit")
    ap.add_argument("--max", type=int, default=25)
    ap.add_argument("--coverage", metavar="YYYY-MM", help="report coverage for a window and exit")
    ap.add_argument("--pull", action="store_true", help="fetch the corpus if absent")
    ap.add_argument("--facebook", action="store_true",
                    help="search the Facebook threads instead of the message corpus. A "
                         "genuinely independent channel, and it covers 2021-2022, which the "
                         "corpus very nearly does not.")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    if args.facebook:
        rows, coverage = load_facebook()
        if not rows:
            raise SystemExit(
                "no Facebook threads on disk (raw/facebook-threads/*.txt is gitignored).\n"
                "Re-fetch them from the public Drive tree — see raw/SOURCES.md.")
    else:
        ensure_corpus(args.pull)
        rows, coverage = load(None)

    if args.coverage:
        print(coverage_report(args.coverage, coverage))
        return 0

    if not args.terms:
        ap.error("give a phrase to search for, or --coverage")

    needles = [normalise(t) for t in args.terms]
    hits = []
    for i, (date, mine, sender, text) in enumerate(rows):
        if args.mine and not mine:
            continue
        if args.lo and date[:len(args.lo)] < args.lo:
            continue
        if args.hi and date[:len(args.hi)] > args.hi:
            continue
        low = normalise(text)
        found = any(n in low for n in needles) if args.any else all(n in low for n in needles)
        if found:
            hits.append((i, date, mine, sender, text))

    # Coverage of the searched window is what makes a null result readable.
    lo = args.lo or min((d for d, *_ in rows if d), default="")
    hi = args.hi or max((d for d, *_ in rows if d), default="")
    months = window_months(lo[:7], hi[:7]) if lo and hi else []
    live = sorted(v for v in coverage.values() if v)
    median = live[len(live) // 2] if live else 0
    empty = [m for m in months if not coverage.get(m)]
    thin = [m for m in months if 0 < coverage.get(m, 0) < median * 0.15]
    searched = sum(coverage.get(m, 0) for m in months)

    if args.json:
        print(json.dumps({
            "query": args.terms, "mode": "any" if args.any else "all",
            "window": [lo, hi], "messages_in_window": searched,
            "months_in_window": len(months), "months_empty": empty,
            "hits": [{"date": d, "outbound": m, "text": t} for _, d, m, _, t in hits[:args.max]],
            "hit_count": len(hits),
        }, indent=2))
        return 0

    query = " ".join(args.terms)
    print(f"# {query!r}   ({'any' if args.any else 'all'} terms"
          f"{', outbound only' if args.mine else ''})\n")
    print(f"{len(hits)} hit(s) in {searched:,} messages, {lo[:7]}–{hi[:7]}")
    if empty or thin:
        if empty:
            print(f"\n**{len(empty)} of {len(months)} months hold no messages at all** — "
                  f"{', '.join(empty[:8])}{' …' if len(empty) > 8 else ''}")
        if thin:
            print(f"**{len(thin)} more are thin** (under 15% of the median month, {median}) — "
                  f"{', '.join(thin[:8])}{' …' if len(thin) > 8 else ''}")
        print("Absence in those windows is `never_observed`, not `known_not_to_occur`.")
    if not hits:
        print("\nNOT FOUND. That is not a negative finding unless the window above is covered.")
        return 0

    print()
    for i, date, mine, sender, text in hits[:args.max]:
        print(f"## {date}  {'OUT' if mine else 'in '}  {sender or ''}".rstrip())
        if args.context:
            for j in range(max(0, i - args.context), min(len(rows), i + args.context + 1)):
                d2, m2, _, t2 = rows[j]
                mark = ">" if j == i else " "
                print(f"  {mark} {d2} {'OUT' if m2 else 'in '} {t2.strip()[:160]}")
        else:
            print(f"  {text.strip()[:400]}")
        print()
    if len(hits) > args.max:
        print(f"… {len(hits) - args.max} more (raise --max)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
